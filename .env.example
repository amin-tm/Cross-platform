# Supabase Postgres connection (Session pooler is recommended for serverless).
# Get this from Supabase Dashboard → Project Settings → Database → Connection string → URI.
# Do not forget to replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase project details from Dashboard → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-with-service-role-key

# Storage bucket name. Any private bucket works; leave as-is unless you renamed it.
SUPABASE_STORAGE_BUCKET=transfers

# Set to "false" when developing over http://localhost so the pol_device cookie is sent.
# Leave unset in production (HTTPS) to keep it secure by default.
COOKIE_SECURE=false
